{
  "$schema": "https://blockstudio.dev/schema/field",
  "name": "field-toggle-values-example",
  "title": "Field Toggle Values Example",
  "attributes": [
    {
      "id": "status",
      "type": "blockstudio-fields/toggle-values",
      "label": "Status",
      "onValue": "enabled",
      "offValue": "disabled",
      "default": "disabled",
      "set": [
        {
          "attribute": "class",
          "value": "is-{attributes.status}"
        }
      ]
    }
  ]
}
